# Copy to ".env" in the project root (your real ".env" is gitignored).
# Goal: one place for "which machine is this?" when you switch laptop vs PC vs full Docker.

# -----------------------------------------------------------------------------
# New (recommended) — set IOT_PUBLIC_HOST to the IP/hostname browsers use for this stack
# -----------------------------------------------------------------------------
# Example: laptop on Wi‑Fi
IOT_PUBLIC_HOST=192.*.*.*
# Optional finer overrides (otherwise IOT_PUBLIC_HOST / Laptop_IP are used)
KEYCLOAK_PUBLIC_HOST=
KAFKA_ADVERTISED_HOST=

# Where Spring user-device-service is reachable FROM Mosquitto go-auth and FROM Keycloak webhooks.
# Hybrid (Spring on PC): LAN IP of that PC (often same as PC_IP).
# All-in-Docker (profile apps): Docker DNS name of the backend service.
SPRING_HOST_HTTP=192.*.*.*

# Host port for the SPA when using profile "apps" (nginx serves on 80 in the container).
FRONTEND_HOST_PORT=3000

# Optional: tighten CORS when UI is on another origin (comma-separated).
# CORS_ALLOWED_ORIGINS=http://192.*.*.*:3000,http://localhost:3000

# Optional: Keycloak public client id from realm-export (default matches repo).
# VITE_KEYCLOAK_CLIENT_ID=iot-frontend-client

# -----------------------------------------------------------------------------
# Legacy (kept for backward compatibility with older compose snippets)
# -----------------------------------------------------------------------------
Laptop_IP=192.*.*.*
PC_IP=192.*.*.*

# -----------------------------------------------------------------------------
# Profile "sim" — Python device simulator (optional)
# -----------------------------------------------------------------------------
# SIM_MQTT_HOST=mosquitto
# SIM_MQTT_PORT=1883
# SIM_MQTT_TLS=false
# Hybrid: point to Spring on your PC
# SIM_USER_DEVICE_SERVICE_URL=http://192.*.*.*:8088/api/v1/devices
