# Mosquitto + go-auth with templated HTTP auth host (SPRING_HOST_HTTP)
FROM debian:stable-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    mosquitto \
    mosquitto-clients \
    gettext-base \
    gosu \
 && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /mosquitto/config /mosquitto/data /mosquitto/log \
 && chown -R mosquitto:mosquitto /mosquitto

COPY go-auth.so /usr/lib/go-auth.so
COPY mosquitto.conf.template /mosquitto/config/mosquitto.conf.template
COPY entrypoint.sh /mosquitto/entrypoint.sh
RUN sed -i 's/\r$//' /mosquitto/entrypoint.sh && chmod +x /mosquitto/entrypoint.sh

EXPOSE 1883 8883

ENTRYPOINT ["/bin/sh", "/mosquitto/entrypoint.sh"]
